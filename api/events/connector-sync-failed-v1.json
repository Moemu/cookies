{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cookies.local/events/connector.sync.failed.v1",
  "title": "Connector Sync Failed v1",
  "type": "object",
  "required": ["event_type", "event_version", "organization_id", "project_id", "data_source_id", "account_ref", "batch_id", "quality", "error_code"],
  "properties": {
    "event_type": {"const": "connector.sync.failed"},
    "event_version": {"const": "v1"},
    "organization_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "data_source_id": {"type": "string", "minLength": 1},
    "account_ref": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "quality": {"type": "string", "enum": ["partial", "delayed", "blocked", "mapping_incomplete"]},
    "error_code": {"type": "string", "minLength": 1},
    "window": {"$ref": "#/$defs/window"},
    "evidence_refs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "$defs": {
    "window": {
      "type": "object",
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  }
}
