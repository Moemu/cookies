{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cookies.local/events/connector.sync.completed.v1",
  "title": "Connector Sync Completed v1",
  "type": "object",
  "required": ["event_type", "event_version", "organization_id", "project_id", "data_source_id", "account_ref", "window", "quality", "batch_id"],
  "properties": {
    "event_type": {"const": "connector.sync.completed"},
    "event_version": {"const": "v1"},
    "organization_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "data_source_id": {"type": "string", "minLength": 1},
    "account_ref": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "window": {"$ref": "#/$defs/window"},
    "quality": {"type": "string", "enum": ["healthy", "partial", "delayed", "blocked", "mapping_incomplete"]},
    "object_kinds": {"type": "array", "items": {"type": "string"}},
    "evidence_refs": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false,
  "$defs": {"window": {"type": "object", "required": ["start", "end"], "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}, "additionalProperties": false}}
}
