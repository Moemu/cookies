{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cookies.local/contracts/creative-ai-native-storyboard-v1.schema.json",
  "title": "AI Native Ad Storyboard Revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "revision", "status", "duration_seconds", "assets", "shots", "channel_profile_id", "channel_profile_hash", "based_on_requirement_revision", "based_on_requirement_hash", "based_on_script_revision", "based_on_script_hash", "generation"],
  "properties": {
    "contract_version": {"const": "creative.ai-native.storyboard/v1"},
    "revision": {"type": "integer", "minimum": 1},
    "status": {"enum": ["draft", "confirmed", "superseded"]},
    "duration_seconds": {"type": "integer", "minimum": 15, "maximum": 30},
    "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}},
    "shots": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/shot"}},
    "channel_profile_id": {"type": "string", "minLength": 1},
    "channel_profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "based_on_requirement_revision": {"type": "integer", "minimum": 1},
    "based_on_requirement_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "based_on_script_revision": {"type": "integer", "minimum": 1},
    "based_on_script_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "generation": {"$ref": "#/$defs/generation"},
    "created_by": {"type": "string"}, "confirmed_by": {"type": "string"},
    "created_at": {"type": "string", "format": "date-time"}, "confirmed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "assetRef": {"type": "object", "additionalProperties": false, "required": ["asset_id", "version"], "properties": {"asset_id": {"type": "string", "minLength": 1}, "version": {"type": "integer", "minimum": 1}}},
    "asset": {"type": "object", "additionalProperties": false, "required": ["id", "role", "name", "source", "status"], "properties": {
      "id": {"type": "string", "minLength": 1}, "role": {"enum": ["product_identity", "person_identity", "scene_reference", "composition_reference", "audio_reference", "brand_element"]},
      "name": {"type": "string", "minLength": 1}, "source": {"enum": ["product_import", "project_asset", "ai_generated"]}, "asset_ref": {"$ref": "#/$defs/assetRef"}, "generation_brief": {"type": "string"}, "regeneration_feedback": {"type": "string", "maxLength": 500}, "status": {"enum": ["ready", "planned", "generating", "failed"]}, "generation_attempt": {"type": "integer", "minimum": 0}, "error_code": {"type": "string"}, "error_message": {"type": "string"}
    }},
    "shot": {"type": "object", "additionalProperties": false, "required": ["id", "start_ms", "end_ms", "duration_ms", "visual_content", "subjects_products_actions", "shot_size", "camera_movement", "reference_asset_ids", "voiceover", "subtitle", "sound_effect", "bgm_direction", "transition", "product_identity_required"], "properties": {
      "id": {"type": "string", "minLength": 1}, "start_ms": {"type": "integer", "minimum": 0}, "end_ms": {"type": "integer", "minimum": 1}, "duration_ms": {"type": "integer", "minimum": 1},
      "visual_content": {"type": "string", "minLength": 1}, "subjects_products_actions": {"type": "string", "minLength": 1}, "shot_size": {"type": "string", "minLength": 1}, "camera_movement": {"type": "string", "minLength": 1}, "reference_asset_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
      "voiceover": {"type": "string", "minLength": 1}, "subtitle": {"type": "string", "minLength": 1}, "sound_effect": {"type": "string", "minLength": 1}, "bgm_direction": {"type": "string", "minLength": 1}, "transition": {"type": "string", "minLength": 1}, "product_identity_required": {"type": "boolean"}
    }},
    "generation": {"type": "object", "additionalProperties": false, "required": ["model_alias", "model_version", "prompt_version", "profile_hash"], "properties": {
      "model_alias": {"type": "string", "minLength": 1}, "model_version": {"type": "string", "minLength": 1}, "route_revision_id": {"type": "string"}, "prompt_version": {"const": "ai-ad-storyboard/douyin/v1"}, "profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
      "input_tokens": {"type": "integer", "minimum": 0}, "output_tokens": {"type": "integer", "minimum": 0}, "total_tokens": {"type": "integer", "minimum": 0}, "latency_ms": {"type": "integer", "minimum": 0}
    }}
  }
}
