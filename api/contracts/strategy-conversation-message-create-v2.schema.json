{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-conversation-message-create-v2.schema.json",
  "title": "Strategy Conversation Message Create v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "content"],
  "properties": {
    "contract_version": {
      "const": "strategy-conversation-message-create/v2"
    },
    "content": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "text"],
            "properties": {
              "type": {"const": "text"},
              "text": {"type": "string", "minLength": 1, "maxLength": 65536}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "document_id", "expected_content_sha256"],
            "properties": {
              "type": {"const": "document_ref"},
              "document_id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[^\\s]+$"},
              "expected_content_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "asset_kind", "asset_id", "asset_version"],
            "properties": {
              "type": {"const": "asset_ref"},
              "asset_kind": {"enum": ["image", "video"]},
              "asset_id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[^\\s]+$"},
              "asset_version": {"type": "integer", "minimum": 1}
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "research_artifact_id", "expected_content_hash"],
            "properties": {
              "type": {"const": "research_ref"},
              "research_artifact_id": {"type": "string", "minLength": 1, "maxLength": 96, "pattern": "^[^\\s]+$"},
              "expected_content_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        ]
      }
    },
    "requested_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reasoning_mode": {"enum": ["standard", "deep"]},
        "web_search": {"enum": ["disabled", "allowed"]},
        "mcp_server_ids": {
          "type": "array",
          "maxItems": 0,
          "items": {"type": "string"}
        }
      }
    }
  }
}
