{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shikanon/cookies/api/contracts/creative-viral-analysis-snapshot-v1.schema.json",
  "title": "creative-viral-analysis-snapshot/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "task_id",
    "source_asset_ref",
    "dimensions",
    "preserve_rules",
    "replace_rules",
    "confidence",
    "evidence_refs",
    "model_lineage",
    "content_hash",
    "created_at"
  ],
  "properties": {
    "contract_version": {"const": "creative-viral-analysis-snapshot/v1"},
    "task_id": {"type": "string", "minLength": 1},
    "source_asset_ref": {"$ref": "#/$defs/assetRef"},
    "dimensions": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {"$ref": "#/$defs/dimension"}
    },
    "preserve_rules": {"$ref": "#/$defs/stringList"},
    "replace_rules": {"$ref": "#/$defs/stringList"},
    "confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "evidence_refs": {"$ref": "#/$defs/stringList"},
    "model_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_alias", "route_revision_id", "prompt_version"],
      "properties": {
        "model_alias": {"const": "cookies.vision.standard"},
        "route_revision_id": {"type": "string", "minLength": 1},
        "prompt_version": {"type": "string", "minLength": 1}
      }
    },
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "assetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "version"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "prompt", "evidence_refs", "confidence", "source"],
      "properties": {
        "id": {
          "enum": [
            "task_goal_type",
            "quality_style_lighting",
            "environment_atmosphere",
            "camera_content",
            "music_sound"
          ]
        },
        "prompt": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/stringList"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "source": {"const": "ai_extracted"}
      }
    }
  }
}
