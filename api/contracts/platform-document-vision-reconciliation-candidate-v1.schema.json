{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform-document-vision-reconciliation-candidate-v1.schema.json",
  "title": "Platform document vision reconciliation candidate v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "organization_id", "project_id", "document_id", "document_title",
    "filename", "attempt_id", "task_index", "page_numbers", "status", "intent_id",
    "provider_code", "model_alias", "model_version", "route_revision_id", "error_code", "updated_at"
  ],
  "properties": {
    "contract_version": {"const": "platform-document-vision-reconciliation-candidate/v1"},
    "organization_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "document_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "document_title": {"type": "string", "maxLength": 160},
    "filename": {"type": "string", "maxLength": 255},
    "attempt_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "task_index": {"type": "integer", "minimum": 0},
    "page_numbers": {"type": "array", "minItems": 1, "maxItems": 24, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "status": {"enum": ["submitting", "unknown"]},
    "intent_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provider_code": {"type": "string", "minLength": 1, "maxLength": 64},
    "model_alias": {"type": "string", "minLength": 1, "maxLength": 160},
    "model_version": {"type": "string", "minLength": 1, "maxLength": 160},
    "route_revision_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "error_code": {"type": "string", "maxLength": 96},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
