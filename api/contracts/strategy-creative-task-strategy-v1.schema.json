{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shikanon/cookies/api/contracts/strategy-creative-task-strategy-v1.schema.json",
  "title": "creative-task-strategy/v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "plan_ref",
    "business_ref",
    "objective",
    "audience",
    "core_message",
    "message_hierarchy",
    "hypotheses",
    "business_strategy",
    "claims_and_evidence",
    "asset_requirements",
    "guardrails",
    "reference_use",
    "open_questions",
    "lineage"
  ],
  "properties": {
    "contract_version": {"const": "creative-task-strategy/v1"},
    "plan_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_id", "revision", "content_hash"],
      "properties": {
        "plan_id": {"$ref": "#/$defs/text"},
        "revision": {"type": "integer", "minimum": 1},
        "content_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "business_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business_code", "generation", "version", "content_hash"],
      "properties": {
        "business_code": {"$ref": "#/$defs/code"},
        "generation": {"type": "integer", "minimum": 1},
        "version": {"$ref": "#/$defs/text"},
        "content_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "objective": {"$ref": "#/$defs/text"},
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "insights"],
      "properties": {
        "primary": {"$ref": "#/$defs/text"},
        "insights": {"$ref": "#/$defs/stringList"}
      }
    },
    "core_message": {"$ref": "#/$defs/text"},
    "message_hierarchy": {"$ref": "#/$defs/stringList"},
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "variable", "metric"],
        "properties": {
          "id": {"$ref": "#/$defs/text"},
          "statement": {"$ref": "#/$defs/text"},
          "variable": {"$ref": "#/$defs/text"},
          "metric": {"$ref": "#/$defs/text"}
        }
      }
    },
    "business_strategy": {
      "type": "object",
      "not": {
        "anyOf": [
          {"required": ["script"]},
          {"required": ["dialogue"]},
          {"required": ["storyboard"]},
          {"required": ["shot"]},
          {"required": ["camera"]},
          {"required": ["model_prompt"]},
          {"required": ["seedance_prompt"]},
          {"required": ["timeline"]},
          {"required": ["creative_version"]},
          {"required": ["prompt"]}
        ]
      }
    },
    "claims_and_evidence": {"$ref": "#/$defs/stringList"},
    "media": {"$ref": "#/$defs/mediaAssessment"},
    "asset_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "required_stage", "requirement"],
        "properties": {
          "role": {"$ref": "#/$defs/text"},
          "required_stage": {"enum": ["strategy", "production"]},
          "requirement": {"$ref": "#/$defs/text"}
        }
      }
    },
    "guardrails": {"$ref": "#/$defs/stringList"},
    "reference_use": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rights_status", "intended_use", "warnings"],
      "properties": {
        "locator": {"type": "string"},
        "rights_status": {"enum": ["unknown", "owned", "licensed", "public_analysis_only"]},
        "intended_use": {"$ref": "#/$defs/text"},
        "warnings": {"$ref": "#/$defs/stringList"}
      }
    },
    "open_questions": {"$ref": "#/$defs/stringList"},
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brief_id",
        "brief_version",
        "brief_content_hash",
        "skill_name",
        "skill_version",
        "skill_content_hash",
        "prompt_version",
        "project_context_version"
      ],
      "properties": {
        "brief_id": {"$ref": "#/$defs/text"},
        "brief_version": {"type": "integer", "minimum": 1},
        "brief_content_hash": {"$ref": "#/$defs/sha256"},
        "source_strategy_id": {"$ref": "#/$defs/text"},
        "source_strategy_revision": {"type": "integer", "minimum": 1},
        "source_strategy_content_hash": {"$ref": "#/$defs/sha256"},
        "skill_name": {"$ref": "#/$defs/code"},
        "skill_version": {"$ref": "#/$defs/text"},
        "skill_content_hash": {"$ref": "#/$defs/hexHash"},
        "prompt_version": {"$ref": "#/$defs/text"},
        "project_context_version": {"type": "integer", "minimum": 1}
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "code": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "hexHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stringList": {
      "type": "array",
      "items": {"$ref": "#/$defs/text"}
    },
    "assetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "version"],
      "properties": {
        "asset_id": {"$ref": "#/$defs/text"},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "mediaInput": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_ref", "role", "origin", "kind", "status", "usefulness",
        "strategy_uses", "observations", "limitations"
      ],
      "properties": {
        "asset_ref": {"$ref": "#/$defs/assetRef"},
        "role": {"$ref": "#/$defs/text"},
        "origin": {"$ref": "#/$defs/text"},
        "kind": {"type": "string"},
        "mime_type": {"type": "string"},
        "status": {"$ref": "#/$defs/text"},
        "width_pixels": {"type": "integer", "minimum": 0},
        "height_pixels": {"type": "integer", "minimum": 0},
        "duration_seconds": {"type": "number", "minimum": 0},
        "usefulness": {"enum": ["semantic", "production_only", "unavailable"]},
        "strategy_uses": {"$ref": "#/$defs/stringList"},
        "observations": {"$ref": "#/$defs/stringList"},
        "limitations": {"$ref": "#/$defs/stringList"}
      }
    },
    "mediaAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items", "semantic_count", "production_only_count",
        "unavailable_count", "warnings"
      ],
      "properties": {
        "items": {"type": "array", "items": {"$ref": "#/$defs/mediaInput"}},
        "semantic_count": {"type": "integer", "minimum": 0},
        "production_only_count": {"type": "integer", "minimum": 0},
        "unavailable_count": {"type": "integer", "minimum": 0},
        "warnings": {"$ref": "#/$defs/stringList"}
      }
    }
  }
}
