{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shikanon/cookies/api/contracts/delivery-platform-skill-definition-v1.schema.json",
  "title": "Delivery Platform Skill Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "display_name", "platform", "capability", "status", "owner", "executable", "real_browser_driver", "submit_allowed", "evidence_observed_at", "last_reviewed_at", "ui_baseline", "schema_ref", "evidence_refs", "page_types", "capabilities", "dynamic_condition_keys", "safety_exit", "write_validation_pending", "gate_one"],
  "properties": {
    "schema_version": { "const": "delivery-platform-skill-definition/v1" },
    "id": { "const": "oceanengine-ecommerce-manual" },
    "version": { "const": "v0.1-calibration" },
    "display_name": { "const": "巨量引擎·电商手动投放" },
    "platform": { "const": "ocean_engine" },
    "capability": { "const": "ecommerce_manual_delivery" },
    "status": { "const": "realtime_dom_validation_required" },
    "owner": { "const": "delivery" },
    "executable": { "const": false },
    "real_browser_driver": { "const": false },
    "submit_allowed": { "const": false },
    "evidence_observed_at": { "const": "2026-08-06" },
    "last_reviewed_at": { "type": "string", "format": "date" },
    "ui_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "platform_build", "locator_contract", "drift_check"],
      "properties": {
        "observed_at": { "const": "2026-08-06" },
        "platform_build": { "const": "unknown" },
        "locator_contract": { "const": "business_semantic_only" },
        "drift_check": { "const": "required_before_gate_one" }
      }
    },
    "schema_ref": { "const": "docs/delivery/schemas/oceanengine-bidding-schema-v0.1.json" },
    "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 9, "uniqueItems": true },
    "page_types": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "evidence_state"],
        "properties": {
          "kind": { "type": "string", "minLength": 1 },
          "evidence_state": { "enum": ["observed", "operator_reviewed", "sample_only", "platform_pending"] }
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed", "forbidden"],
      "properties": {
        "allowed": { "type": "array", "items": { "enum": ["navigate", "identify_page", "identify_account", "identify_project", "fill_unsubmitted_form", "readback_field", "discard_local_draft", "verify_no_write"] }, "minItems": 1, "uniqueItems": true },
        "forbidden": { "type": "array", "items": { "enum": ["save", "create", "submit", "enable", "pause_remote_object", "modify_remote_object", "delete", "upload", "authorize"] }, "minItems": 1, "uniqueItems": true }
      }
    },
    "dynamic_condition_keys": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 6, "uniqueItems": true },
    "safety_exit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "required_proof"],
      "properties": {
        "method": { "const": "discard_unsubmitted_local_form" },
        "required_proof": { "const": "return_to_known_readonly_page_and_confirm_no_platform_object_or_status_change" }
      }
    },
    "write_validation_pending": { "type": "array", "items": { "enum": ["save", "submit", "write_idempotency", "platform_object_id_readback", "server_validation", "post_write_status"] }, "minItems": 6, "uniqueItems": true },
    "gate_one": {
      "type": "object",
      "additionalProperties": false,
      "required": ["purpose", "ready", "required_scope", "acceptance_checklist"],
      "properties": {
        "purpose": { "const": "revalidate_stage_b_evidence_and_calibrate_realtime_dom_locators" },
        "ready": { "const": false },
        "required_scope": { "type": "array", "items": { "enum": ["test_account_reference", "allowed_platform_project_ids", "action_fill_unsubmitted_form", "budget_ceiling_cny"] }, "minItems": 4, "uniqueItems": true },
        "acceptance_checklist": { "type": "array", "items": { "enum": ["reidentify_current_page_and_account", "confirm_ui_has_not_drifted", "establish_stable_dom_locators", "fill_only_unsubmitted_fields", "read_back_every_field", "discard_draft", "confirm_no_platform_write"] }, "minItems": 7, "uniqueItems": true }
      }
    }
  }
}
