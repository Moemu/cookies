{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shikanon/cookies/api/contracts/creative-video-intake-v1.schema.json",
  "title": "creative-video-intake/v1",
  "description": "Creative-owned, normalized and immutable input for video planning, generation and delivery gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "intake_id",
    "organization_id",
    "project_id",
    "status",
    "source",
    "campaign",
    "video",
    "product",
    "creative",
    "source_assets",
    "claims",
    "evidence_refs",
    "readiness",
    "confirmation",
    "created_at"
  ],
  "properties": {
    "contract_version": {"const": "creative-video-intake/v1"},
    "intake_id": {"type": "string", "minLength": 1},
    "organization_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "status": {
      "enum": ["waiting_for_brief", "fixture_ready", "brief_ready", "superseded"]
    },
    "source": {"$ref": "#/$defs/source"},
    "campaign": {"$ref": "#/$defs/campaign"},
    "video": {"$ref": "#/$defs/video"},
    "product": {"$ref": "#/$defs/product"},
    "creative": {"$ref": "#/$defs/creative"},
    "source_assets": {
      "type": "array",
      "items": {"$ref": "#/$defs/sourceAsset"}
    },
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    },
    "evidence_refs": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidenceRef"}
    },
    "readiness": {"$ref": "#/$defs/readiness"},
    "confirmation": {"$ref": "#/$defs/confirmation"},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "documentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_name", "locator"],
      "properties": {
        "file_name": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "page_refs": {"$ref": "#/$defs/stringList"},
        "note": {"type": "string"}
      }
    },
    "source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "confirmed_by"],
          "properties": {
            "kind": {"const": "manual"},
            "confirmed_by": {"type": "string", "minLength": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "fixture_id", "documents"],
          "properties": {
            "kind": {"const": "fixture"},
            "fixture_id": {"type": "string", "minLength": 1},
            "documents": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "#/$defs/documentRef"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "package_id",
            "package_version",
            "expected_content_hash"
          ],
          "properties": {
            "kind": {"const": "strategy_package"},
            "package_id": {"type": "string", "minLength": 1},
            "package_version": {"type": "integer", "minimum": 1},
            "expected_content_hash": {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            }
          }
        }
      ]
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "objective",
        "audience",
        "core_message",
        "call_to_action",
        "channels",
        "locale"
      ],
      "properties": {
        "objective": {"type": "string"},
        "audience": {"type": "string"},
        "core_message": {"type": "string"},
        "call_to_action": {"type": "string"},
        "channels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["douyin", "kuaishou", "xiaohongshu_video", "weibo_video"]
          }
        },
        "locale": {"type": "string", "pattern": "^[a-z]{2}-[A-Z]{2}$"}
      }
    },
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "purpose",
        "target_duration_seconds",
        "aspect_ratio",
        "resolution",
        "variant_count",
        "hook_deadline_seconds",
        "audio_policy",
        "transition"
      ],
      "properties": {
        "mode": {
          "enum": [
            "short_drama_preroll",
            "game_preroll",
            "commerce_preroll",
            "viral_remake",
            "brand_video"
          ]
        },
        "purpose": {"enum": ["performance", "brand"]},
        "target_duration_seconds": {"type": "integer", "minimum": 4, "maximum": 60},
        "aspect_ratio": {"enum": ["9:16", "16:9", "1:1"]},
        "resolution": {"enum": ["480p", "720p", "1080p"]},
        "variant_count": {"type": "integer", "minimum": 1, "maximum": 10},
        "hook_deadline_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 3
        },
        "audio_policy": {
          "enum": ["silent", "generated_audio", "retain_source", "mix_bgm", "voiceover"]
        },
        "transition": {
          "enum": ["hard_cut", "fade", "action_match", "audio_bridge", "not_applicable"]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "brand_video"}}},
          "then": {"properties": {"purpose": {"const": "brand"}}}
        },
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "short_drama_preroll",
                  "game_preroll",
                  "commerce_preroll",
                  "viral_remake"
                ]
              }
            }
          },
          "then": {"properties": {"purpose": {"const": "performance"}}}
        },
        {
          "if": {
            "properties": {
              "mode": {
                "enum": [
                  "short_drama_preroll",
                  "game_preroll",
                  "commerce_preroll"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "target_duration_seconds": {"type": "integer", "maximum": 10},
              "hook_deadline_seconds": {"type": "number", "maximum": 1}
            }
          }
        }
      ]
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "brand_name",
        "product_name",
        "selling_points",
        "proof_points",
        "usage_scenarios"
      ],
      "properties": {
        "brand_name": {"type": "string"},
        "product_name": {"type": "string"},
        "selling_points": {"$ref": "#/$defs/stringList"},
        "proof_points": {"$ref": "#/$defs/stringList"},
        "usage_scenarios": {"$ref": "#/$defs/stringList"}
      }
    },
    "creative": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "concept",
        "tone",
        "visual_keywords",
        "mandatory_elements",
        "prohibited_claims",
        "reference_policy",
        "similarity_policy"
      ],
      "properties": {
        "concept": {"type": "string"},
        "tone": {"$ref": "#/$defs/stringList"},
        "visual_keywords": {"$ref": "#/$defs/stringList"},
        "mandatory_elements": {"$ref": "#/$defs/stringList"},
        "prohibited_claims": {"$ref": "#/$defs/stringList"},
        "reference_policy": {"type": "string"},
        "similarity_policy": {"type": "string"}
      }
    },
    "assetRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "version"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "sourceAsset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "required", "availability", "rights_status", "note"],
      "properties": {
        "role": {
          "enum": [
            "main_video",
            "reference_video",
            "product_image",
            "character_image",
            "gameplay_video",
            "bgm",
            "logo",
            "other"
          ]
        },
        "required": {"type": "boolean"},
        "availability": {"enum": ["ready", "placeholder", "missing"]},
        "asset_ref": {"$ref": "#/$defs/assetRef"},
        "fixture_uri": {"type": "string", "minLength": 1},
        "rights_status": {
          "enum": ["confirmed", "pending", "fixture_only", "not_required"]
        },
        "note": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"availability": {"const": "ready"}}},
          "then": {"required": ["asset_ref"]}
        },
        {
          "if": {"properties": {"availability": {"const": "placeholder"}}},
          "then": {"required": ["fixture_uri"]}
        }
      ]
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "status", "evidence_refs"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "status": {
          "enum": ["brief_supported", "manual_confirmed", "assumption", "needs_confirmation"]
        },
        "evidence_refs": {"$ref": "#/$defs/stringList"}
      }
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_type", "locator", "note"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_type": {
          "enum": [
            "fixture_document",
            "strategy_package",
            "asset_analysis",
            "manual_confirmation"
          ]
        },
        "locator": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "value", "reason"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "value": {"type": "string"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planning_ready",
        "generation_ready",
        "production_ready",
        "missing_fields",
        "blockers",
        "assumptions"
      ],
      "properties": {
        "planning_ready": {"type": "boolean"},
        "generation_ready": {"type": "boolean"},
        "production_ready": {"type": "boolean"},
        "missing_fields": {"$ref": "#/$defs/stringList"},
        "blockers": {"$ref": "#/$defs/stringList"},
        "assumptions": {
          "type": "array",
          "items": {"$ref": "#/$defs/assumption"}
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "status"],
      "properties": {
        "required": {"type": "boolean"},
        "status": {"enum": ["unconfirmed", "confirmed"]},
        "confirmed_by": {"type": "string", "minLength": 1},
        "confirmed_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
