{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cookies.local/contracts/creative-ai-native-requirement-workspace-v1.schema.json",
  "title": "AI Native Ad Requirement Workspace",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "workspace_id",
    "creative_intake_id",
    "creative_task_id",
    "organization_id",
    "project_id",
    "status",
    "current_stage",
    "workspace_version",
    "current_revision",
    "requirement",
    "created_by",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "workspace_id": {"type": "string", "minLength": 1},
    "creative_intake_id": {"type": "string", "minLength": 1},
    "creative_task_id": {"type": "string", "minLength": 1},
    "organization_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "confirmed"]},
    "current_stage": {"enum": ["requirement", "script", "storyboard", "production"]},
    "workspace_version": {"type": "integer", "minimum": 1},
	"active_operation_id": {"type": "string", "minLength": 1},
	"active_operation_version": {"type": "integer", "minimum": 1},
    "current_revision": {"type": "integer", "minimum": 1},
    "confirmed_revision": {"type": "integer", "minimum": 1},
    "requirement": {"oneOf": [{"$ref": "./creative-ai-native-requirement-v1.schema.json"}, {"$ref": "./creative-ai-native-requirement-v2.schema.json"}]},
    "script_status": {"enum": ["generating", "draft", "confirmed", "failed"]},
    "current_script_revision": {"type": "integer", "minimum": 1},
    "confirmed_script_revision": {"type": "integer", "minimum": 1},
    "script": {"$ref": "./creative-ai-native-script-v1.schema.json"},
    "storyboard_status": {"enum": ["generating", "draft", "confirmed", "failed"]},
    "current_storyboard_revision": {"type": "integer", "minimum": 1},
    "confirmed_storyboard_revision": {"type": "integer", "minimum": 1},
    "storyboard": {"$ref": "./creative-ai-native-storyboard-v1.schema.json"},
    "storyboard_plan": {"$ref": "./creative-ai-native-storyboard-v1.schema.json"},
    "storyboard_error_code": {"type": "string", "minLength": 1},
    "storyboard_error_message": {"type": "string", "minLength": 1},
    "production_status": {"enum": ["running", "assets_ready", "rendering", "completed", "render_failed", "failed", "cancelled"]},
    "current_production_revision": {"type": "integer", "minimum": 1},
    "production_plan": {"$ref": "./creative-ai-native-production-plan-v1.schema.json"},
    "production_progress": {"$ref": "./creative-ai-native-production-progress-v1.schema.json"},
    "created_by": {"type": "string", "minLength": 1},
    "confirmed_by": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  }
}
