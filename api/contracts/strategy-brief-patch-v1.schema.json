{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shikanon/cookies/api/contracts/strategy-brief-patch-v1.schema.json",
  "title": "strategy-brief-patch/v1",
  "type": "object",
  "required": ["contract_version", "base_version", "operations"],
  "properties": {
    "contract_version": {"const": "strategy-brief-patch/v1"},
    "base_version": {"type": "integer", "minimum": 1},
    "confirmation_mode": {"enum": ["draft", "confirm"]},
    "operations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["op", "field_path", "value", "source", "confidence", "confirmation"],
        "properties": {
          "op": {"const": "set"},
          "field_path": {
            "enum": [
              "campaign.objective",
              "audience.primary",
              "proposition",
              "channels",
              "budget.total",
              "schedule.window",
              "constraints",
              "measurement.primary_kpi"
            ]
          },
          "value": {},
          "source": {
            "type": "object",
            "required": ["type", "id"],
            "properties": {
              "type": {"enum": ["conversation_message", "user_edit", "project_asset", "ai_suggestion"]},
              "id": {"type": "string", "minLength": 1},
              "locator": {"type": "string"}
            },
            "additionalProperties": false
          },
          "confidence": {"enum": ["low", "medium", "high"]},
          "confirmation": {"enum": ["unconfirmed", "confirmed"]}
        },
        "additionalProperties": false
      }
    },
    "questions": {"type": "array", "items": {"type": "string"}},
    "warnings": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
