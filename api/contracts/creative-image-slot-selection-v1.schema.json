{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cookies.local/contracts/creative-image-slot-selection-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "organization_id", "project_id", "task_id", "draft_revision", "image_plan_order", "adopted_attempt_id", "version", "adopted_by", "adopted_at"],
  "properties": {
    "contract_version": {"const": "creative-image-slot-selection/v1"},
    "organization_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "draft_revision": {"type": "integer", "minimum": 1},
    "image_plan_order": {"type": "integer", "minimum": 1, "maximum": 3},
    "adopted_attempt_id": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "adopted_by": {"type": "string", "minLength": 1},
    "adopted_at": {"type": "string", "format": "date-time"}
  }
}
