{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shikanon/cookies/api/contracts/strategy-brief-version-v1.schema.json",
  "title": "strategy-brief-version/v1",
  "type": "object",
  "required": ["contract_version", "campaign", "audience", "proposition", "channels", "budget", "schedule", "constraints", "measurement"],
  "properties": {
    "contract_version": {"const": "strategy-brief-version/v1"},
    "campaign": {
      "type": "object",
      "required": ["objective"],
      "properties": {"objective": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "audience": {
      "type": "object",
      "required": ["primary"],
      "properties": {"primary": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "proposition": {"type": "string", "minLength": 1},
    "channels": {
      "type": "array",
      "minItems": 1,
      "items": {"const": "xiaohongshu"}
    },
    "budget": {
      "type": "object",
      "required": ["total"],
      "properties": {"total": {"type": "string"}},
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "required": ["window"],
      "properties": {"window": {"type": "string"}},
      "additionalProperties": false
    },
    "constraints": {"type": "array", "items": {"type": "string"}},
    "measurement": {
      "type": "object",
      "required": ["primary_kpi"],
      "properties": {"primary_kpi": {"type": "string"}},
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
