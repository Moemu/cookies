{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-research-adoption-proposal-v1.schema.json",
  "title": "Strategy Research Adoption Proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "id", "organization_id", "project_id", "workspace_id", "conversation_id",
    "proposal_kind", "target_type", "target_id", "target_version", "base_content_hash", "operations",
    "rationale", "risk", "status", "finding_ids", "source_research_run_id", "stale_reason",
    "created_by", "version", "created_at", "updated_at"
  ],
  "properties": {
    "contract_version": {"const": "strategy-research-adoption-proposal/v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 96},
    "organization_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "workspace_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "conversation_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "proposal_kind": {"const": "research"},
    "target_type": {"enum": ["brief_draft", "strategy_revision"]},
    "target_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "target_version": {"type": "integer", "minimum": 1},
    "base_content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "operations": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"$ref": "#/$defs/operation"}},
    "rationale": {"type": "string", "minLength": 1, "maxLength": 2000},
    "risk": {"enum": ["low", "medium", "high"]},
    "status": {"enum": ["proposed", "applied", "edited", "ignored", "stale"]},
    "finding_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 96}},
    "source_research_run_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "stale_reason": {"type": "string", "maxLength": 500},
    "supersedes_proposal_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "created_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "applied_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "applied_at": {"type": "string", "format": "date-time"},
    "ignored_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "ignored_at": {"type": "string", "format": "date-time"},
    "version": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "stale"}}}, "then": {"properties": {"stale_reason": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"status": {"enum": ["proposed", "applied", "edited", "ignored"]}}}, "then": {"properties": {"stale_reason": {"type": "string", "maxLength": 0}}}}
  ],
  "$defs": {
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op", "field_path", "value", "source", "confidence", "confirmation"],
      "properties": {
        "op": {"const": "set"},
        "field_path": {"type": "string", "minLength": 1, "maxLength": 160},
        "value": {},
        "source": {
          "type": "object", "additionalProperties": false, "required": ["type", "id"],
          "properties": {
            "type": {"const": "research_finding"},
            "id": {"type": "string", "minLength": 1, "maxLength": 96},
            "locator": {"type": "string", "maxLength": 512}
          }
        },
        "confidence": {"enum": ["low", "medium", "high"]},
        "confirmation": {"const": "proposed"}
      }
    }
  }
}
