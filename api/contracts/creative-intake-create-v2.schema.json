{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shikanon/cookies/api/contracts/creative-intake-create-v2.schema.json",
  "title": "creative-intake-create/v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "source",
    "strategy_package_ref",
    "selected_route_id"
  ],
  "properties": {
    "contract_version": {
      "const": "creative-intake-create/v2"
    },
    "source": {
      "const": "strategy_package"
    },
    "strategy_package_ref": {
      "$ref": "./strategy-creative-handoff-v1.schema.json#/$defs/intakePackageRef"
    },
    "selected_route_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "intent": {
      "const": "create_clarification_intake"
    }
  },
  "oneOf": [
    {
      "properties": {
        "selected_route_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "not": {
        "required": [
          "intent"
        ]
      }
    },
    {
      "properties": {
        "selected_route_id": {
          "type": "null"
        },
        "intent": {
          "const": "create_clarification_intake"
        }
      },
      "required": [
        "intent"
      ]
    }
  ]
}
