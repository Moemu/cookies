{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-research-finding-v1.schema.json",
  "title": "Strategy Research Finding v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "id", "claim", "status", "time_scope", "confidence", "supporting_source_ids", "conflicting_source_ids", "target", "implication", "round", "content_hash"],
  "properties": {
    "contract_version": {"const": "strategy-research-finding/v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 96},
    "claim": {"type": "string", "minLength": 1, "maxLength": 2000},
    "status": {"enum": ["tentative", "verified", "conflicting", "invalid"]},
    "time_scope": {"type": "string", "minLength": 1, "maxLength": 96},
    "confidence": {"enum": ["low", "medium", "high"]},
    "supporting_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 96}},
    "conflicting_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 96}},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact", "field_path"],
      "properties": {
        "artifact": {"enum": ["brief", "strategy"]},
        "field_path": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "implication": {"type": "string", "minLength": 1, "maxLength": 2000},
    "proposed_value": {},
    "round": {"type": "integer", "minimum": 1, "maximum": 20},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "verified"}}}, "then": {"properties": {"supporting_source_ids": {"type": "array", "minItems": 1}}}},
    {"if": {"properties": {"status": {"const": "conflicting"}}}, "then": {"properties": {"supporting_source_ids": {"type": "array", "minItems": 1}, "conflicting_source_ids": {"type": "array", "minItems": 1}}}}
  ]
}
