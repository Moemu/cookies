{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shikanon/cookies/api/contracts/oceanengine-readonly-coverage-ledger-v2.schema.json",
  "title": "OceanEngine Read-only Coverage Ledger v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observed_at", "platform", "allowed_host", "scope", "completion_state", "source_inventory", "account_context_sha256", "targets", "rejected_locators", "page_evidence", "no_write_proof", "evidence_sha256"],
  "properties": {
    "schema_version": { "const": "oceanengine-readonly-coverage-ledger/v2" },
    "observed_at": { "type": "string", "format": "date-time" },
    "platform": { "const": "ocean_engine" },
    "allowed_host": { "const": "ad.oceanengine.com" },
    "scope": { "const": "current_page_only" },
    "completion_state": { "const": "partial_current_page_only" },
    "source_inventory": { "$ref": "#/$defs/sourceInventory" },
    "account_context_sha256": { "$ref": "#/$defs/hash" },
    "targets": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": { "$ref": "#/$defs/target" },
      "allOf": [
        { "contains": { "type": "object", "required": ["target"], "properties": { "target": { "const": "account_context" } } } },
        { "contains": { "type": "object", "required": ["target"], "properties": { "target": { "const": "project_list" } } } },
        { "contains": { "type": "object", "required": ["target"], "properties": { "target": { "const": "project_create" } } } },
        { "contains": { "type": "object", "required": ["target"], "properties": { "target": { "const": "project_edit" } } } },
        { "contains": { "type": "object", "required": ["target"], "properties": { "target": { "const": "promotion_list" } } } },
        { "contains": { "type": "object", "required": ["target"], "properties": { "target": { "const": "promotion_create" } } } },
        { "contains": { "type": "object", "required": ["target"], "properties": { "target": { "const": "promotion_edit" } } } },
        { "contains": { "type": "object", "required": ["target"], "properties": { "target": { "const": "material_relation_summary" } } } },
        { "contains": { "type": "object", "required": ["target"], "properties": { "target": { "const": "report_overview" } } } }
      ]
    },
    "rejected_locators": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "reason", "element_count", "source"],
        "properties": {
          "key": { "$ref": "#/$defs/locatorKey" },
          "reason": { "const": "unscoped_duplicate" },
          "element_count": { "type": "integer", "minimum": 2 },
          "source": { "const": "real_current_page" }
        }
      }
    },
    "page_evidence": {
      "type": "array",
      "maxItems": 8,
      "items": { "$ref": "#/$defs/pageEvidence" }
    },
    "no_write_proof": { "$ref": "#/$defs/noWriteProof" },
    "evidence_sha256": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "targetName": { "enum": ["account_context", "project_list", "project_create", "project_edit", "promotion_list", "promotion_create", "promotion_edit", "material_relation_summary", "report_overview"] },
    "locatorKey": { "enum": ["data_center", "account_report", "project_report", "promotion_report", "material_report", "create_project", "project_budget_column", "create_promotion", "promotion_budget_column", "edit_project", "project_marketing_purpose", "project_name", "save_and_close", "material_overview", "project_deep_optimization", "promotion_budget", "promotion_name", "promotion_operational_state"] },
    "sourceInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_page_family_count", "manifest_field_count", "locator_fixture_count", "coordinate_fallback_allowed", "remote_write_authorized"],
      "properties": {
        "manifest_page_family_count": { "const": 6 },
        "manifest_field_count": { "type": "integer", "minimum": 1 },
        "locator_fixture_count": { "const": 4 },
        "coordinate_fallback_allowed": { "const": false },
        "remote_write_authorized": { "const": false }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["https_host", "page_type", "account_context", "necessary_structure", "locator_uniqueness"],
      "properties": {
        "https_host": { "$ref": "#/$defs/checkState" },
        "page_type": { "$ref": "#/$defs/checkState" },
        "account_context": { "$ref": "#/$defs/checkState" },
        "necessary_structure": { "$ref": "#/$defs/checkState" },
        "locator_uniqueness": { "$ref": "#/$defs/checkState" }
      }
    },
    "checkState": { "enum": ["passed", "failed", "not_run", "not_applicable"] },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "element_count", "visible", "unique", "accessible_name_sha256", "source"],
      "properties": {
        "key": { "$ref": "#/$defs/locatorKey" },
        "kind": { "enum": ["visible_text", "stable_test_attribute"] },
        "element_count": { "const": 1 },
        "visible": { "const": true },
        "unique": { "const": true },
        "accessible_name_sha256": { "$ref": "#/$defs/hash" },
        "source": { "const": "real_current_page" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "attempted", "status", "reason", "checks", "drift_state", "locators"],
      "properties": {
        "target": { "$ref": "#/$defs/targetName" },
        "attempted": { "const": true },
        "status": { "enum": ["confirmed_shell", "confirmed_fields", "blocked", "not_accessible"] },
        "reason": { "enum": ["current_page_confirmed", "current_page_different", "verification_failed"] },
        "checks": { "$ref": "#/$defs/checks" },
        "drift_state": { "enum": ["stable", "page_drift", "verification_pending"] },
        "locators": { "type": "array", "items": { "$ref": "#/$defs/locator" } },
        "page_evidence_sha256": { "$ref": "#/$defs/hash" },
        "field_evidence_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_sha256", "observable_object_count", "population_state", "page_state_sha256"],
      "properties": {
        "evidence_sha256": { "$ref": "#/$defs/hash" },
        "observable_object_count": { "type": "integer", "minimum": 0 },
        "population_state": { "enum": ["populated", "empty", "loading", "unknown"] },
        "page_state_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "pageEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "before", "after", "no_write_proof", "evidence_sha256"],
      "properties": {
        "target": { "enum": ["project_list", "project_create", "project_edit", "promotion_list", "promotion_create", "promotion_edit", "material_relation_summary", "report_overview"] },
        "before": { "$ref": "#/$defs/snapshot" },
        "after": { "$ref": "#/$defs/snapshot" },
        "no_write_proof": { "$ref": "#/$defs/pageNoWriteProof" },
        "evidence_sha256": { "$ref": "#/$defs/hash" }
      }
    },
    "pageNoWriteProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_state", "comparison_scope", "write_actions_executed", "mutation_api_surface", "new_object_count", "observable_state_change_count", "draft_residual_count", "draft_residual_delta", "same_page_target", "same_account_context"],
      "properties": {
        "proof_state": { "enum": ["confirmed", "verification_pending"] },
        "comparison_scope": { "const": "current_page_observable_counts_and_status" },
        "write_actions_executed": { "const": 0 },
        "mutation_api_surface": { "const": "absent" },
        "new_object_count": { "type": "integer", "minimum": 0 },
        "observable_state_change_count": { "enum": [0, 1] },
        "draft_residual_count": { "type": "integer", "minimum": 0 },
        "draft_residual_delta": { "type": "integer" },
        "same_page_target": { "type": "boolean" },
        "same_account_context": { "type": "boolean" }
      }
    },
    "noWriteProof": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proof_state", "comparison_scope", "write_actions_executed", "mutation_api_surface", "confirmed_page_count", "total_new_object_count", "total_observable_state_change_count", "total_draft_residual_count"],
      "properties": {
        "proof_state": { "enum": ["confirmed", "verification_pending"] },
        "comparison_scope": { "const": "current_page_observable_counts_and_status" },
        "write_actions_executed": { "const": 0 },
        "mutation_api_surface": { "const": "absent" },
        "confirmed_page_count": { "type": "integer", "minimum": 0, "maximum": 8 },
        "total_new_object_count": { "type": "integer", "minimum": 0 },
        "total_observable_state_change_count": { "type": "integer", "minimum": 0 },
        "total_draft_residual_count": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
