{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "strategy-research-run-v2.schema.json",
  "title": "Strategy Research Run v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "id", "organization_id", "project_id", "mode", "run_mode", "category", "purpose",
    "query", "document_ids", "disclosed_fields", "disclosed_chunk_ids", "status", "current_round", "max_rounds",
    "time_budget_seconds", "token_budget", "input_snapshot_ref", "input_snapshot_hash", "coverage", "open_gaps",
    "stop_reason", "heartbeat_at", "report_artifact_id", "confirmed_by", "confirmed_at", "artifacts", "iterations",
    "findings", "created_at", "updated_at"
  ],
  "properties": {
    "contract_version": {"const": "strategy-research-run/v2"},
    "id": {"type": "string", "minLength": 1, "maxLength": 96},
    "organization_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "project_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "mode": {"const": "web"},
    "run_mode": {"enum": ["quick", "deep"]},
    "category": {"enum": ["general", "audience", "competitor", "industry"]},
    "purpose": {"enum": ["conversation_web_search", "deep_research"]},
    "source_ref": {"$ref": "#/$defs/resource_ref"},
    "query": {"type": "string", "minLength": 1, "maxLength": 2000},
    "document_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 96}},
    "disclosed_fields": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 160}},
    "disclosed_chunk_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 96}},
    "status": {"enum": ["queued", "planning", "searching", "reading", "cross_checking", "drafting", "auditing", "completed", "partially_completed", "failed", "cancelled"]},
    "current_round": {"type": "integer", "minimum": 0, "maximum": 20},
    "max_rounds": {"type": "integer", "minimum": 1, "maximum": 20},
    "time_budget_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
    "token_budget": {"type": "integer", "minimum": 1},
    "input_snapshot_ref": {"type": "string", "minLength": 1, "maxLength": 160},
    "input_snapshot_hash": {"$ref": "#/$defs/sha256"},
    "coverage": {"type": "object", "maxProperties": 32, "additionalProperties": {"type": "boolean"}},
    "open_gaps": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 300}},
    "stop_reason": {"type": "string", "maxLength": 96},
    "heartbeat_at": {"oneOf": [{"type": "null"}, {"type": "string", "format": "date-time"}]},
    "report_artifact_id": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 96}]},
    "started_at": {"type": "string", "format": "date-time"},
    "completed_at": {"type": "string", "format": "date-time"},
    "confirmed_by": {"type": "string", "minLength": 1, "maxLength": 128},
    "confirmed_at": {"type": "string", "format": "date-time"},
    "error_code": {"type": "string", "maxLength": 96},
    "error_message": {"type": "string", "maxLength": 2000},
    "provider_code": {"type": "string", "maxLength": 96},
    "model_version": {"type": "string", "maxLength": 160},
    "provider_response_id": {"type": "string", "maxLength": 160},
    "usage": {"$ref": "#/$defs/usage"},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "iterations": {"type": "array", "items": {"$ref": "#/$defs/iteration"}},
    "findings": {"type": "array", "items": {"$ref": "strategy-research-finding-v1.schema.json"}},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"run_mode": {"const": "deep"}}},
      "then": {
        "required": ["source_ref"],
        "properties": {
          "purpose": {"const": "deep_research"},
          "source_ref": {"type": "object", "properties": {"type": {"const": "strategy_workspace"}}}
        }
      }
    },
    {
      "if": {"properties": {"run_mode": {"const": "quick"}}},
      "then": {
        "required": ["source_ref"],
        "properties": {
          "purpose": {"const": "conversation_web_search"},
          "source_ref": {"type": "object", "properties": {"type": {"const": "strategy_message"}}}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "resource_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id"],
      "properties": {
        "type": {"enum": ["strategy_message", "strategy_workspace"]},
        "id": {"type": "string", "minLength": 1, "maxLength": 96},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0}
      }
    },
    "iteration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "research_run_id", "round", "status", "objective", "query", "action_summary", "source_ids", "artifact_ids", "finding_ids", "coverage", "open_gaps", "input_hash", "output_hash", "started_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 96},
        "research_run_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "round": {"type": "integer", "minimum": 1, "maximum": 20},
        "status": {"enum": ["running", "completed", "failed", "cancelled"]},
        "objective": {"type": "string", "maxLength": 2000},
        "query": {"type": "string", "maxLength": 2000},
        "action_summary": {"type": "string", "maxLength": 2000},
        "source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "artifact_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "finding_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "coverage": {"type": "object", "additionalProperties": {"type": "boolean"}},
        "open_gaps": {"type": "array", "items": {"type": "string"}},
        "usage": {"$ref": "#/$defs/usage"},
        "input_hash": {"$ref": "#/$defs/sha256"},
        "output_hash": {"$ref": "#/$defs/sha256"},
        "error_code": {"type": "string"},
        "error_message": {"type": "string"},
        "started_at": {"type": "string", "format": "date-time"},
        "completed_at": {"type": "string", "format": "date-time"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "organization_id", "project_id", "research_run_id", "source_class", "media_type", "title", "url", "canonical_url", "domain", "retrieved_at", "verification_status", "content_hash", "start_index", "end_index", "support_level"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 96},
        "organization_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "research_run_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "source_class": {"enum": ["web", "toutiao", "douyin", "weather", "unknown"]},
        "media_type": {"enum": ["article", "video", "data", "unknown"]},
        "title": {"type": "string"},
        "url": {"type": "string", "format": "uri"},
        "canonical_url": {"type": "string", "format": "uri"},
        "domain": {"type": "string"},
        "published_at": {"type": "string", "format": "date-time"},
        "retrieved_at": {"type": "string", "format": "date-time"},
        "verification_status": {"enum": ["model_cited", "content_verified", "conflicted", "invalid"]},
        "content_hash": {"type": "string"},
        "start_index": {"type": "integer", "minimum": 0},
        "end_index": {"type": "integer", "minimum": 0},
        "support_level": {"enum": ["model_cited", "content_verified", "conflicted", "invalid"]},
        "provider_locator": {}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "organization_id", "project_id", "research_run_id", "source_type", "category", "title", "content", "citations", "sources", "content_hash", "created_at"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 96},
        "organization_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "project_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "research_run_id": {"type": "string", "minLength": 1, "maxLength": 96},
        "source_type": {"type": "string"},
        "category": {"enum": ["general", "audience", "competitor", "industry"]},
        "title": {"type": "string"},
        "source_url": {"type": "string", "format": "uri"},
        "content": {"type": "string"},
        "citations": {"type": "array", "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
        "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
        "content_hash": {"$ref": "#/$defs/sha256"},
        "created_at": {"type": "string", "format": "date-time"}
      }
    }
  }
}
