{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "platform-media-understanding-artifact-v1.schema.json",
  "title": "Platform Media Understanding Artifact v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "id", "organization_id", "project_id", "asset_ref", "asset_kind",
    "asset_sha256", "profile", "profile_version", "input_identity_hash", "status",
    "visible_text", "observations", "inferences", "risks", "unknowns", "keyframes",
    "transcript", "warnings", "model_lineage", "content_hash", "created_by", "created_at", "updated_at"
  ],
  "properties": {
    "contract_version": {"const": "platform-media-understanding-artifact/v1"},
    "id": {"$ref": "#/$defs/id"},
    "organization_id": {"$ref": "#/$defs/id"},
    "project_id": {"$ref": "#/$defs/id"},
    "asset_ref": {"$ref": "#/$defs/project_asset_ref"},
    "asset_kind": {"enum": ["image", "video"]},
    "asset_sha256": {"$ref": "#/$defs/sha256"},
    "profile": {"type": "string", "minLength": 1, "maxLength": 96},
    "profile_version": {"type": "string", "minLength": 1, "maxLength": 96},
    "input_identity_hash": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["running", "ready", "partial", "failed"]},
    "job_id": {"$ref": "#/$defs/id"},
    "summary": {"type": "string", "maxLength": 800},
    "visible_text": {"$ref": "#/$defs/evidence_list"},
    "observations": {"$ref": "#/$defs/evidence_list"},
    "inferences": {"$ref": "#/$defs/evidence_list"},
    "risks": {"$ref": "#/$defs/evidence_list"},
    "unknowns": {"$ref": "#/$defs/evidence_list"},
    "keyframes": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp_ms", "frame_ref"],
        "properties": {
          "timestamp_ms": {"type": "integer", "minimum": 0, "maximum": 90000},
          "frame_ref": {"$ref": "#/$defs/project_asset_ref"}
        }
      }
    },
    "transcript": {"$ref": "#/$defs/evidence_list"},
    "warnings": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 200}},
    "model_lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_version", "schema_version"],
      "properties": {
        "provider_code": {"type": "string", "minLength": 1, "maxLength": 96},
        "model_alias": {"type": "string", "minLength": 1, "maxLength": 160},
        "model_version": {"type": "string", "minLength": 1, "maxLength": 160},
        "route_revision_id": {"$ref": "#/$defs/id"},
        "prompt_version": {"type": "string", "minLength": 1, "maxLength": 96},
        "schema_version": {"type": "string", "minLength": 1, "maxLength": 96}
      }
    },
    "content_hash": {"$ref": "#/$defs/sha256"},
    "error_code": {"type": "string", "minLength": 1, "maxLength": 96},
    "error_message": {"type": "string", "minLength": 1, "maxLength": 500},
    "created_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["user", "service"]},
        "id": {"$ref": "#/$defs/id"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\s]+$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "asset_version_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_id", "version"],
      "properties": {
        "asset_id": {"$ref": "#/$defs/id"},
        "version": {"type": "integer", "minimum": 1}
      }
    },
    "project_asset_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_id", "asset_version"],
      "properties": {
        "project_id": {"$ref": "#/$defs/id"},
        "asset_version": {"$ref": "#/$defs/asset_version_ref"}
      }
    },
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "asset_ref"],
      "properties": {
        "kind": {"enum": ["image", "video", "video_frame"]},
        "asset_ref": {"$ref": "#/$defs/project_asset_ref"},
        "timestamp_ms": {"type": "integer", "minimum": 0, "maximum": 90000},
        "frame_ref": {"$ref": "#/$defs/project_asset_ref"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "confidence", "locator"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "text": {"type": "string", "minLength": 1, "maxLength": 500},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "locator": {"$ref": "#/$defs/locator"}
      }
    },
    "evidence_list": {"type": "array", "maxItems": 24, "items": {"$ref": "#/$defs/evidence"}}
  }
}
