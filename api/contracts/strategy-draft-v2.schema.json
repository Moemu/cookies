{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shikanon/cookies/api/contracts/strategy-draft-v2.schema.json",
  "title": "strategy-draft/v2",
  "type": "object",
  "required": ["contract_version", "objective", "audience", "proposition", "channel_strategy", "creative_recommendations", "constraints", "budget_and_cadence", "experiment_matrix", "measurement", "assumptions_and_gaps", "lineage", "executive_summary", "cross_platform_role", "platform_plans", "evidence_refs", "compliance"],
  "properties": {
    "contract_version": {"const": "strategy-draft/v2"},
    "objective": {"type": "string", "minLength": 1},
    "audience": {
      "type": "object",
      "required": ["primary", "insights"],
      "properties": {
        "primary": {"type": "string", "minLength": 1},
        "insights": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "proposition": {"type": "string", "minLength": 1},
    "channel_strategy": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/channel"}
    },
    "creative_recommendations": {"type": "array", "minItems": 3, "items": {"type": "string", "minLength": 1}},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "budget_and_cadence": {
      "type": "object",
      "required": ["budget", "cadence"],
      "properties": {"budget": {"type": "string"}, "cadence": {"type": "string"}},
      "additionalProperties": false
    },
    "experiment_matrix": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["hypothesis", "variable", "metric"],
        "properties": {
          "hypothesis": {"type": "string", "minLength": 1},
          "variable": {"type": "string", "minLength": 1},
          "metric": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "measurement": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "assumptions_and_gaps": {"type": "array", "items": {"type": "string"}},
    "executive_summary": {"type": "string", "minLength": 1},
    "cross_platform_role": {"type": "string", "minLength": 1},
    "platform_plans": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/platformPlan"}
    },
    "evidence_refs": {"type": "array", "items": {"type": "string"}},
    "lineage": {
      "type": "object",
      "required": ["brief_id", "brief_version", "project_context_version", "skill_versions"],
      "properties": {
        "brief_id": {"type": "string", "minLength": 1},
        "brief_version": {"type": "integer", "minimum": 1},
        "project_context_version": {"type": "integer", "minimum": 1},
        "skill_versions": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "compliance": {
      "type": "object",
      "required": ["contract_version", "passed", "issues", "checked_at"],
      "properties": {
        "contract_version": {"const": "strategy-compliance-report/v1"},
        "content_hash": {"type": "string"},
        "passed": {"type": "boolean"},
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["rule_id", "severity", "message"],
            "properties": {
              "rule_id": {"type": "string"},
              "severity": {"enum": ["warning", "blocker"]},
              "message": {"type": "string"},
              "evidence": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "checked_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "channel": {
      "type": "object",
      "required": ["platform", "role", "formats"],
      "properties": {
        "platform": {"enum": ["xiaohongshu", "douyin", "taobao_tmall", "wechat_ecosystem"]},
        "role": {"type": "string", "minLength": 1},
        "formats": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "platformPlan": {
      "type": "object",
      "required": ["platform", "role", "audience_angle", "content_pillars", "formats", "conversion_path", "cadence", "primary_kpi", "creative_ideas", "constraints"],
      "properties": {
        "platform": {"enum": ["xiaohongshu", "douyin", "taobao_tmall", "wechat_ecosystem"]},
        "role": {"type": "string", "minLength": 1},
        "audience_angle": {"type": "string"},
        "content_pillars": {"type": "array", "items": {"type": "string"}},
        "formats": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "conversion_path": {"type": "string", "minLength": 1},
        "cadence": {"type": "string"},
        "primary_kpi": {"type": "string"},
        "creative_ideas": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
