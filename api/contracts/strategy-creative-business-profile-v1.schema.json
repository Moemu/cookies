{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shikanon/cookies/api/contracts/strategy-creative-business-profile-v1.schema.json",
  "title": "Strategy creative business profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "business_code",
    "generation",
    "version",
    "display_name",
    "summary",
    "lifecycle",
    "selectable",
    "display_order",
    "match_rules",
    "questions",
    "requirements",
    "output_fields",
    "reference_policy",
    "skill_name",
    "skill_version",
    "skill_content_hash",
    "content_hash",
    "owner",
    "reviewed_by",
    "published_at"
  ],
  "properties": {
    "business_code": {"$ref": "#/$defs/code"},
    "generation": {"type": "integer", "minimum": 1},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "display_name": {"$ref": "#/$defs/text"},
    "summary": {"$ref": "#/$defs/text"},
    "lifecycle": {"enum": ["draft", "active", "deprecated", "retired"]},
    "selectable": {"type": "boolean"},
    "display_order": {"type": "integer", "minimum": 0},
    "match_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "field", "operator", "weight", "reason"],
        "properties": {
          "id": {"$ref": "#/$defs/code"},
          "field": {"$ref": "#/$defs/code"},
          "operator": {"enum": ["equals", "in", "contains", "present", "count_gte"]},
          "values": {"$ref": "#/$defs/stringList"},
          "number": {"type": "integer"},
          "weight": {"type": "integer", "minimum": -100, "maximum": 100},
          "reason": {"$ref": "#/$defs/text"},
          "required": {"type": "boolean"}
        }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "type", "required_for"],
        "properties": {
          "id": {"$ref": "#/$defs/code"},
          "label": {"$ref": "#/$defs/text"},
          "type": {"enum": ["text", "textarea", "single_select", "multi_select", "boolean", "asset_ref", "reference_locator"]},
          "required_for": {"enum": ["recommendation", "strategy", "production"]},
          "brief_source_path": {"$ref": "#/$defs/code"},
          "help": {"type": "string"},
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value", "label"],
              "properties": {
                "value": {"$ref": "#/$defs/code"},
                "label": {"$ref": "#/$defs/text"}
              }
            }
          },
          "depends_on": {
            "type": "object",
            "additionalProperties": false,
            "required": ["question_id", "equals"],
            "properties": {
              "question_id": {"$ref": "#/$defs/code"},
              "equals": {}
            }
          },
          "validation": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "max_length": {"type": "integer", "minimum": 1},
              "max_items": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    },
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["strategy", "production"],
      "properties": {
        "strategy": {"$ref": "#/$defs/stringList"},
        "production": {"$ref": "#/$defs/stringList"}
      }
    },
    "output_fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "label", "type", "required", "description"],
        "properties": {
          "key": {"$ref": "#/$defs/code"},
          "label": {"$ref": "#/$defs/text"},
          "type": {"enum": ["string", "string_array", "boolean"]},
          "required": {"type": "boolean"},
          "max_items": {"type": "integer", "minimum": 1},
          "max_length": {"type": "integer", "minimum": 1},
          "description": {"$ref": "#/$defs/text"}
        }
      }
    },
    "reference_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allows_unknown_for_strategy", "allowed_strategy_uses", "production_confirmations"],
      "properties": {
        "allows_unknown_for_strategy": {"type": "boolean"},
        "allowed_strategy_uses": {"$ref": "#/$defs/stringList"},
        "production_confirmations": {"$ref": "#/$defs/stringList"}
      }
    },
    "skill_name": {"$ref": "#/$defs/code"},
    "skill_version": {"$ref": "#/$defs/text"},
    "skill_content_hash": {"$ref": "#/$defs/hexHash"},
    "content_hash": {"$ref": "#/$defs/sha256"},
    "owner": {"$ref": "#/$defs/text"},
    "reviewed_by": {"$ref": "#/$defs/text"},
    "reviewed_at": {"type": "string", "format": "date-time"},
    "published_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "code": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]*$"},
    "text": {"type": "string", "minLength": 1},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "hexHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "stringList": {
      "type": "array",
      "items": {"$ref": "#/$defs/text"},
      "uniqueItems": true
    }
  }
}
