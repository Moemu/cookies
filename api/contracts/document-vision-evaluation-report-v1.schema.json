{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "document-vision-evaluation-report-v1.schema.json",
  "title": "Document vision evaluation report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "dataset_id",
    "dataset_sha256",
    "label_policy_version",
    "cost_policy_version",
    "case_count",
    "review_count",
    "category_count",
    "cases_by_category",
    "review_orders_by_category",
    "mean_baseline_quality",
    "mean_hybrid_quality",
    "mean_quality_gain",
    "worst_case_regression",
    "correction_count_reduction",
    "total_baseline_correction_time_ms",
    "total_hybrid_correction_time_ms",
    "total_correction_time_saved_ms",
    "mean_baseline_correction_time_ms",
    "mean_hybrid_correction_time_ms",
    "median_baseline_correction_time_ms",
    "median_hybrid_correction_time_ms",
    "correction_time_reduction",
    "mean_baseline_latency_ms",
    "mean_hybrid_latency_ms",
    "total_hybrid_billable_pages",
    "total_hybrid_cost_millicny",
    "auto_enable_allowed",
    "blockers"
  ],
  "properties": {
    "contract_version": {"const": "document-vision-evaluation-report/v1"},
    "dataset_id": {"type": "string", "minLength": 1, "maxLength": 96},
    "dataset_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "label_policy_version": {"type": "string", "minLength": 1, "maxLength": 96},
    "cost_policy_version": {"type": "string", "minLength": 1, "maxLength": 96},
    "case_count": {"type": "integer", "minimum": 1, "maximum": 500},
    "review_count": {"type": "integer", "minimum": 2, "maximum": 4000},
    "category_count": {"type": "integer", "minimum": 1, "maximum": 8},
    "cases_by_category": {"$ref": "#/$defs/categoryCounts"},
    "review_orders_by_category": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(text_pdf|scanned_pdf|two_column|table_dense|chinese_ppt|broken_font_map|header_footer_noise|image_led)$": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "baseline_first": {"type": "integer", "minimum": 0},
            "hybrid_first": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "mean_baseline_quality": {"type": "number", "minimum": 0, "maximum": 1},
    "mean_hybrid_quality": {"type": "number", "minimum": 0, "maximum": 1},
    "mean_quality_gain": {"type": "number", "minimum": -1, "maximum": 1},
    "worst_case_regression": {"type": "number", "minimum": 0, "maximum": 1},
    "correction_count_reduction": {"type": "number", "maximum": 1},
    "total_baseline_correction_time_ms": {"type": "integer", "minimum": 1},
    "total_hybrid_correction_time_ms": {"type": "integer", "minimum": 1},
    "total_correction_time_saved_ms": {"type": "integer"},
    "mean_baseline_correction_time_ms": {"type": "integer", "minimum": 1},
    "mean_hybrid_correction_time_ms": {"type": "integer", "minimum": 1},
    "median_baseline_correction_time_ms": {"type": "integer", "minimum": 1},
    "median_hybrid_correction_time_ms": {"type": "integer", "minimum": 1},
    "correction_time_reduction": {"type": "number", "maximum": 1},
    "mean_baseline_latency_ms": {"type": "integer", "minimum": 1},
    "mean_hybrid_latency_ms": {"type": "integer", "minimum": 1},
    "total_hybrid_billable_pages": {"type": "integer", "minimum": 1},
    "total_hybrid_cost_millicny": {"type": "integer", "minimum": 0},
    "auto_enable_allowed": {"type": "boolean"},
    "blockers": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z0-9_]{1,96}$"}
    }
  },
  "$defs": {
    "categoryCounts": {
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^(text_pdf|scanned_pdf|two_column|table_dense|chinese_ppt|broken_font_map|header_footer_noise|image_led)$": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
