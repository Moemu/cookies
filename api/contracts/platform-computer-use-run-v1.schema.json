{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shikanon/cookies/api/contracts/platform-computer-use-run-v1.schema.json",
  "title": "Platform Computer Use Run v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "organization_id", "project_id", "platform", "account_id", "authority", "environment_id", "profile_id", "lease_id", "policy_id", "state", "paused", "takeover_active", "version", "idempotency_key", "request_hash", "created_by", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": "computer-use-run/v1" },
    "id": { "type": "string", "minLength": 1 },
    "organization_id": { "type": "string", "minLength": 1 },
    "project_id": { "type": "string", "minLength": 1 },
    "platform": { "const": "ocean_engine" },
    "account_id": { "type": "string", "minLength": 1 },
    "authority": { "$ref": "#/$defs/authority" },
    "environment_id": { "type": "string", "minLength": 1 },
    "profile_id": { "type": "string", "minLength": 1 },
    "lease_id": { "type": "string", "minLength": 1 },
    "policy_id": { "type": "string", "minLength": 1 },
    "state": { "enum": ["queued", "environment_check", "awaiting_takeover", "preparing", "awaiting_confirmation", "submitting", "verifying", "succeeded", "failed", "partial", "result_unknown", "cancelled"] },
    "blocking_reason": { "$ref": "#/$defs/blockingReason" },
    "paused": { "type": "boolean" },
    "takeover_active": { "type": "boolean" },
    "version": { "type": "integer", "minimum": 1 },
    "idempotency_key": { "type": "string", "minLength": 1, "maxLength": 255 },
    "request_hash": { "$ref": "#/$defs/hash" },
    "created_by": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "blockingReason": {
      "enum": ["FINAL_CONFIRMATION_REQUIRED", "FINAL_CONFIRMATION_INVALID", "APPROVAL_INVALID", "LEASE_INVALID", "KILL_SWITCH_ACTIVE", "ACCOUNT_MISMATCH", "PROJECT_NOT_ALLOWED", "SITE_NOT_ALLOWED", "PAGE_DRIFT", "WORKFLOW_DRIFT", "SKILL_DRIFT", "RESULT_RECONCILIATION_REQUIRED"]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "organization_id", "project_id", "business_execution_id", "change_set_id", "approval_id", "approval_action_hash", "account_reference_id", "object_fingerprint", "action", "budget_limit_minor", "currency", "plan_canonical_hash", "intent_canonical_hash", "feedback_canonical_hash", "decision_canonical_hash", "configuration_canonical_hash", "workflow_id", "workflow_canonical_hash", "workflow_step_id", "skill_id", "skill_version"],
      "properties": {
        "schema_version": { "const": "computer-use-authority/v1" },
        "organization_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "business_execution_id": { "type": "string", "minLength": 1 },
        "change_set_id": { "type": "string", "minLength": 1 },
        "approval_id": { "type": "string", "minLength": 1 },
        "approval_action_hash": { "$ref": "#/$defs/hash" },
        "account_reference_id": { "type": "string", "minLength": 1 },
        "object_fingerprint": { "type": "string", "minLength": 1 },
        "action": { "type": "string", "minLength": 1 },
        "budget_limit_minor": { "type": "integer", "minimum": 0 },
        "currency": { "const": "CNY" },
        "plan_canonical_hash": { "$ref": "#/$defs/hash" },
        "intent_canonical_hash": { "$ref": "#/$defs/hash" },
        "feedback_canonical_hash": { "$ref": "#/$defs/hash" },
        "decision_canonical_hash": { "$ref": "#/$defs/hash" },
        "configuration_canonical_hash": { "$ref": "#/$defs/hash" },
        "workflow_id": { "type": "string", "minLength": 1 },
        "workflow_canonical_hash": { "$ref": "#/$defs/hash" },
        "workflow_step_id": { "type": "string", "minLength": 1 },
        "skill_id": { "type": "string", "minLength": 1 },
        "skill_version": { "type": "string", "minLength": 1 }
      }
    }
  }
}
