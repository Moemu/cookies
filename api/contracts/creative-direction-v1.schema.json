{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shikanon/cookies/api/contracts/creative-direction-v1.schema.json",
  "title": "creative-direction/v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "direction_id", "organization_id", "project_id", "batch_id", "intake_id", "input_identity_hash", "route_id", "concept", "creative_rationale", "message_plan", "execution_outline", "guardrail_trace", "status", "version", "content_hash", "created_at"],
  "properties": {
    "contract_version": {"const": "creative-direction/v1"},
    "direction_id": {"type": "string", "minLength": 1},
    "organization_id": {"type": "string", "minLength": 1},
    "project_id": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "minLength": 1},
    "intake_id": {"type": "string", "minLength": 1},
    "input_identity_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "route_id": {"type": "string", "minLength": 1},
    "concept": {"type": "string", "minLength": 1},
    "creative_rationale": {"type": "string", "minLength": 1},
    "message_plan": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "execution_outline": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "guardrail_trace": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "status": {"enum": ["candidate", "confirmed", "superseded"]},
    "confirmed_by": {"type": "string", "minLength": 1},
    "version": {"type": "integer", "minimum": 1},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "confirmed_at": {"type": "string", "format": "date-time"},
    "created_at": {"type": "string", "format": "date-time"}
  }
}
