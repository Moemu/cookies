# Server-only Ark credential. Leave empty until a developer configures a local environment.
ARK_API_KEY=

# Optional Ark-compatible API base URL. The default is used when omitted.
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Optional local path for durable generation job metadata.
GENERATION_DATA_FILE=server/data/generation-jobs.json
