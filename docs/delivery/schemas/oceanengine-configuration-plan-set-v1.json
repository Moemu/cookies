{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shikanon/cookies/docs/delivery/schemas/oceanengine-configuration-plan-set-v1.json",
  "title": "OceanEngine configuration plan set v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "configuration_id", "configuration_hash", "account_reference", "forms"],
  "properties": {
    "schema_version": {"const": "oceanengine-configuration-plan-set/v1"},
    "configuration_id": {"type": "string", "minLength": 1},
    "configuration_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "account_reference": {"type": "string", "pattern": "^[0-9]+$"},
    "forms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["internal_object_kind", "internal_object_id", "plan", "diff"],
        "properties": {
          "internal_object_kind": {"enum": ["project", "promotion"]},
          "internal_object_id": {"type": "string", "minLength": 1},
          "platform_object_id": {"type": "string", "pattern": "^[0-9]+$"},
          "depends_on": {"type": "string", "minLength": 1},
          "plan": {"$ref": "oceanengine-playwright-rpa-plan-v3.json"},
          "diff": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field_key", "operation", "target"],
              "properties": {
                "field_key": {"type": "string", "minLength": 1},
                "operation": {"type": "string", "minLength": 1},
                "target": {}
              }
            }
          }
        }
      }
    }
  }
}
