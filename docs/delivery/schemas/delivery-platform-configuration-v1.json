{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shikanon/cookies/docs/delivery/schemas/delivery-platform-configuration-v1.json",
  "title": "Delivery platform configuration envelope v1",
  "description": "Delivery-owned immutable target configuration. canonical_hash is SHA-256 over RFC 8785 JCS(payload) only; compilation metadata is outside the hash projection.",
  "$ref": "#/$defs/DeliveryPlatformConfigurationEnvelope",
  "$defs": {
    "StableReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["namespace", "object_kind", "scope", "external_id", "reference_state"],
      "properties": {
        "namespace": { "type": "string", "minLength": 1 },
        "object_kind": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "external_id": { "type": ["string", "null"] },
        "source_version": { "type": ["string", "null"] },
        "content_hash": { "type": ["string", "null"] },
        "display_name_snapshot": { "type": ["string", "null"] },
        "evidence_version": { "type": ["string", "null"] },
        "reference_state": {
          "type": "string",
          "enum": ["resolved", "unresolved", "blocked", "redacted"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "reference_state": { "const": "resolved" } },
            "required": ["reference_state"]
          },
          "then": {
            "properties": { "external_id": { "type": "string", "minLength": 1 } }
          }
        }
      ]
    },
    "ReferenceState": {
      "type": "string",
      "enum": ["resolved", "unresolved", "blocked", "redacted"]
    },
    "EvidenceState": {
      "type": "string",
      "enum": [
        "observed",
        "sample_only",
        "operator_reviewed",
        "platform_pending",
        "owner_pending",
        "blocked_by_event_asset",
        "write_validation_pending"
      ]
    },
    "ActionBoundary": {
      "type": "object",
      "required": ["event", "remote_write", "validation_state"],
      "additionalProperties": false,
      "properties": {
        "event": {
          "type": "string",
          "enum": [
            "save_project_and_continue_to_promotion",
            "save_project_and_close",
            "save_promotion_and_close",
            "cancel_without_change",
            "enable_project",
            "pause_project",
            "restart_project",
            "enable_promotion",
            "pause_promotion",
            "restart_promotion"
          ]
        },
        "remote_write": { "type": "boolean" },
        "validation_state": {
          "type": "string",
          "enum": ["readonly_located", "write_validation_pending", "validated"]
        }
      }
    },
    "RepairTarget": {
      "type": "object",
      "required": ["field", "section", "label"],
      "additionalProperties": false,
      "properties": {
        "field": { "type": "string", "minLength": 1 },
        "section": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "Condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": { "all": { "type": "array", "items": { "$ref": "#/$defs/Condition" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": { "any": { "type": "array", "items": { "$ref": "#/$defs/Condition" } } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/Condition" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "equals"],
          "properties": {
            "field": { "type": "string", "minLength": 1 },
            "equals": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "exists"],
          "properties": {
            "field": { "type": "string", "minLength": 1 },
            "exists": { "type": "boolean" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "reference_state_is"],
          "properties": {
            "field": { "type": "string", "minLength": 1 },
            "reference_state_is": { "$ref": "#/$defs/ReferenceState" }
          }
        }
      ]
    },
    "ConditionResult": {
      "type": "object",
      "required": ["condition", "result", "evidence_states"],
      "additionalProperties": false,
      "properties": {
        "condition": { "$ref": "#/$defs/Condition" },
        "result": { "type": "boolean" },
        "evidence_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceState" },
          "minItems": 1,
          "uniqueItems": true
        },
        "repair_target": { "oneOf": [{ "$ref": "#/$defs/RepairTarget" }, { "type": "null" }] },
        "blocked_reason": { "type": ["string", "null"], "minLength": 1 }
      },
      "oneOf": [
        {
          "required": ["result", "repair_target"],
          "properties": {
            "result": { "const": true },
            "repair_target": { "$ref": "#/$defs/RepairTarget" }
          }
        },
        {
          "required": ["result", "blocked_reason"],
          "properties": {
            "result": { "const": false },
            "blocked_reason": { "type": "string", "minLength": 1 },
            "repair_target": { "type": "null" }
          }
        }
      ]
    },
    "DeliveryIdentity": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": { "mode": { "const": "account_info" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "authorized_identity_ref"],
          "properties": {
            "mode": { "const": "douyin_account" },
            "authorized_identity_ref": { "$ref": "#/$defs/StableReference" }
          }
        }
      ]
    },
    "PlatformProjectDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_schema_version",
        "project_draft_id",
        "account_ref",
        "marketing_purpose",
        "marketing_scenario",
        "carrier",
        "targeting",
        "schedule",
        "budget_and_bidding",
        "project_name"
      ],
      "properties": {
        "draft_schema_version": { "const": "delivery-platform-configuration/v1" },
        "project_draft_id": { "type": "string", "minLength": 1 },
        "account_ref": { "$ref": "#/$defs/StableReference" },
        "marketing_purpose": { "type": "string", "minLength": 1 },
        "marketing_scenario": { "type": "string", "minLength": 1 },
        "marketing_product_ref": { "oneOf": [{ "$ref": "#/$defs/StableReference" }, { "type": "null" }] },
        "application_ref": { "oneOf": [{ "$ref": "#/$defs/StableReference" }, { "type": "null" }] },
        "carrier": { "type": "string", "minLength": 1 },
        "optimization_target_ref": { "oneOf": [{ "$ref": "#/$defs/StableReference" }, { "type": "null" }] },
        "deep_optimization_mode": { "type": ["string", "null"] },
        "delivery_mode": { "type": ["string", "null"] },
        "targeting": { "type": "object" },
        "schedule": { "type": "object" },
        "budget_and_bidding": { "type": "object" },
        "monitoring": { "type": "object" },
        "project_name": { "type": "string", "minLength": 1 }
      }
    },
    "PlatformPromotionDraft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "draft_schema_version",
        "promotion_draft_id",
        "delivery_identity",
        "base_material_refs",
        "copy_items",
        "promotion_name"
      ],
      "properties": {
        "draft_schema_version": { "const": "delivery-platform-configuration/v1" },
        "promotion_draft_id": { "type": "string", "minLength": 1 },
        "delivery_identity": { "$ref": "#/$defs/DeliveryIdentity" },
        "base_material_refs": { "type": "array", "items": { "$ref": "#/$defs/StableReference" } },
        "copy_items": { "type": "array", "items": { "type": "object" } },
        "native_anchor_ref": { "oneOf": [{ "$ref": "#/$defs/StableReference" }, { "type": "null" }] },
        "landing_page_ref": { "oneOf": [{ "$ref": "#/$defs/StableReference" }, { "type": "null" }] },
        "direct_link_ref": { "oneOf": [{ "$ref": "#/$defs/StableReference" }, { "type": "null" }] },
        "product_information": { "type": "object" },
        "creative_components": { "type": "array", "items": { "type": "object" } },
        "promotion_settings": { "type": "object" },
        "promotion_name": { "type": "string", "minLength": 1 }
      }
    },
    "DeliveryPlatformConfigurationPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["payload_schema_version", "source", "platform", "platform_project", "platform_promotions"],
      "properties": {
        "payload_schema_version": { "const": "delivery-platform-configuration/v1" },
        "source": { "type": "string", "enum": ["readonly", "mock", "replay"] },
        "platform": { "type": "string", "minLength": 1 },
        "platform_project": { "$ref": "#/$defs/PlatformProjectDraft" },
        "platform_promotions": { "type": "array", "items": { "$ref": "#/$defs/PlatformPromotionDraft" } }
      }
    },
    "CompilationMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_states", "conditions", "action_boundaries"],
      "properties": {
        "evidence_states": {
          "type": "array",
          "items": { "$ref": "#/$defs/EvidenceState" },
          "minItems": 1,
          "uniqueItems": true
        },
        "conditions": { "type": "array", "items": { "$ref": "#/$defs/ConditionResult" } },
        "action_boundaries": { "type": "array", "items": { "$ref": "#/$defs/ActionBoundary" } },
        "evidence_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "DeliveryPlatformConfigurationEnvelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "organization_id",
        "project_id",
        "plan_id",
        "version_number",
        "hash_algorithm",
        "canonical_hash",
        "payload",
        "compilation_metadata"
      ],
      "properties": {
        "schema_version": { "const": "delivery-platform-configuration/v1" },
        "organization_id": { "type": "string", "minLength": 1 },
        "project_id": { "type": "string", "minLength": 1 },
        "plan_id": { "type": "string", "minLength": 1 },
        "version_number": { "type": "integer", "minimum": 1 },
        "hash_algorithm": { "const": "RFC8785-JCS-SHA256(payload)" },
        "canonical_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "payload": { "$ref": "#/$defs/DeliveryPlatformConfigurationPayload" },
        "compilation_metadata": { "$ref": "#/$defs/CompilationMetadata" }
      }
    }
  }
}
