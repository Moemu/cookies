{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shikanon/cookies/docs/delivery/schemas/oceanengine-calibration-manifest-v1.json",
  "title": "OceanEngineCalibrationManifest v1",
  "description": "Versioned, redacted observation facts. This manifest is never remote-write authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "platform",
    "session_evidence_ref",
    "observation_boundary",
    "compatibility_policy",
    "path_dimensions",
    "condition_vocabulary",
    "page_families",
    "fields",
    "coverage_cases",
    "consumer_mappings"
  ],
  "properties": {
    "schema_version": { "const": "oceanengine-calibration-manifest/v1" },
    "manifest_id": {
      "type": "string",
      "pattern": "^oceanengine-calibration-[a-z0-9-]+$"
    },
    "platform": { "const": "ocean_engine" },
    "session_evidence_ref": {
      "const": "docs/delivery/evidence/oceanengine-calibration-session-2026-08-16.json"
    },
    "observation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "account_scope",
        "platform_build",
        "complete_coverage_definition",
        "local_calibration_allowed",
        "remote_write_authorized"
      ],
      "properties": {
        "account_scope": { "const": "redacted_current_test_account" },
        "platform_build": { "type": "string" },
        "complete_coverage_definition": { "type": "string", "minLength": 1 },
        "local_calibration_allowed": { "const": true },
        "remote_write_authorized": { "const": false }
      }
    },
    "compatibility_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_is_observation_only",
        "unknown_platform_values",
        "page_drift",
        "future_account_or_rollout"
      ],
      "properties": {
        "manifest_is_observation_only": { "const": true },
        "unknown_platform_values": {
          "enum": ["retain_as_open_set", "record_blocked_case"]
        },
        "page_drift": { "enum": ["stop_case_and_record_page_drift"] },
        "future_account_or_rollout": { "enum": ["not_covered"] }
      }
    },
    "path_dimensions": {
      "description": "Primary page-path dimensions only. Field condition_dimensions can contain other declared condition inputs.",
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pathDimension" }
    },
    "condition_vocabulary": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/conditionVocabularyEntry" }
    },
    "page_families": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/pageFamily" }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/field" }
    },
    "coverage_cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/coverageCase" }
    },
    "consumer_mappings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/consumer" }
    }
  },
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {
          "enum": [
            "role_name",
            "label",
            "visible_text",
            "placeholder",
            "attribute",
            "domain_key"
          ]
        },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "pathDimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "observed_values"],
      "properties": {
        "key": { "type": "string" },
        "observed_values": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "conditionVocabularyEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "source_kind",
        "source",
        "value_kind",
        "unknown_value_treatment"
      ],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "source_kind": { "enum": ["configuration_path", "stable_reference"] },
        "source": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "DisplayNameSnapshot" }
        },
        "value_kind": { "enum": ["enum", "reference"] },
        "known_values": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "unknown_value_treatment": { "const": "platform_pending" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "value_kind": { "const": "enum" } },
            "required": ["value_kind"]
          },
          "then": { "required": ["known_values"] },
          "else": { "not": { "required": ["known_values"] } }
        },
        {
          "if": {
            "properties": { "source_kind": { "const": "stable_reference" } },
            "required": ["source_kind"]
          },
          "then": { "properties": { "value_kind": { "const": "reference" } } }
        }
      ]
    },
    "pageFamily": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "page_kind",
        "entry_locator",
        "page_fingerprint",
        "safety_exit",
        "final_write_boundary",
        "evidence_state"
      ],
      "properties": {
        "id": { "type": "string" },
        "page_kind": {
          "enum": [
            "project_list",
            "project_create",
            "project_edit",
            "promotion_list",
            "promotion_create",
            "promotion_edit"
          ]
        },
        "entry_locator": { "$ref": "#/$defs/locator" },
        "page_fingerprint": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/locator" }
        },
        "safety_exit": {
          "enum": [
            "cancel_local_draft",
            "return_to_readonly_list",
            "discard_unsaved_edit",
            "not_in_scope"
          ]
        },
        "final_write_boundary": { "type": "string" },
        "evidence_state": { "enum": ["observed", "not_in_scope", "page_drift"] }
      }
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "owner",
        "page_family",
        "value_type",
        "required_state",
        "editable_state",
        "enum_state",
        "locator",
        "computer_use",
        "evidence_state",
        "consumers"
      ],
      "properties": {
        "key": { "type": "string" },
        "semantic_label": { "type": "string", "minLength": 1 },
        "configuration_requirement": { "type": "string", "minLength": 1 },
        "owner": {
          "enum": [
            "delivery_intent",
            "oceanengine_configuration",
            "promotion_draft",
            "platform_dynamic_reference",
            "runtime_only"
          ]
        },
        "page_family": { "type": "string" },
        "value_type": {
          "enum": [
            "dynamic_enum",
            "dynamic_reference",
            "boolean",
            "schedule",
            "money_minor",
            "text",
            "object"
          ]
        },
        "unit": { "type": "string" },
        "condition": { "type": "string" },
        "condition_dimensions": {
          "description": "All declared inputs for this field condition. This list is independent of path_dimensions.",
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "condition_state": { "enum": ["evaluable", "dependency_only"] },
        "condition_rule": { "$ref": "#/$defs/conditionRule" },
        "required_state": {
          "enum": [
            "unknown",
            "observed_optional",
            "observed_required",
            "conditional"
          ]
        },
        "editable_state": {
          "enum": ["observed_editable", "observed_readonly", "conditional"]
        },
        "enum_state": {
          "enum": [
            "sample_only",
            "observed_current_set",
            "observed_open_set",
            "dynamic_reference"
          ]
        },
        "locator": { "$ref": "#/$defs/locator" },
        "computer_use": { "$ref": "#/$defs/computerUse" },
        "evidence_state": {
          "enum": [
            "observed",
            "sample_only",
            "blocked_by_event_asset",
            "blocked_by_missing_material",
            "blocked_by_input_constraint",
            "blocked_by_platform_capability",
            "platform_pending",
            "page_drift"
          ]
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "allOf": [
        {
          "if": { "required": ["condition"] },
          "then": { "required": ["condition_dimensions", "condition_state"] }
        },
        {
          "if": {
            "properties": { "condition_state": { "const": "evaluable" } },
            "required": ["condition_state"]
          },
          "then": { "required": ["condition_rule"] }
        },
        {
          "if": {
            "properties": { "condition_state": { "const": "dependency_only" } },
            "required": ["condition_state"]
          },
          "then": {
            "not": { "required": ["condition_rule"] },
            "properties": {
              "evidence_state": { "const": "platform_pending" },
              "computer_use": { "$ref": "#/$defs/noActionComputerUse" }
            }
          }
        }
      ]
    },
    "conditionPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "operator"],
      "properties": {
        "dimension": { "type": "string", "minLength": 1 },
        "operator": { "enum": ["equals", "in", "not_in", "present", "absent"] },
        "values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "operator": { "enum": ["equals", "in", "not_in"] }
            },
            "required": ["operator"]
          },
          "then": { "required": ["values"] },
          "else": { "not": { "required": ["values"] } }
        },
        {
          "if": {
            "properties": { "operator": { "const": "equals" } },
            "required": ["operator"]
          },
          "then": { "properties": { "values": { "maxItems": 1 } } }
        }
      ]
    },
    "conditionRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all"],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/conditionPredicate" }
        }
      }
    },
    "computerUse": {
      "oneOf": [
        { "$ref": "#/$defs/actionComputerUse" },
        { "$ref": "#/$defs/noActionComputerUse" }
      ]
    },
    "actionComputerUse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "scope",
        "target",
        "expected_target_count",
        "readback"
      ],
      "properties": {
        "operation": {
          "enum": [
            "choose_exact_visible_option",
            "open_reference_picker",
            "fill_text",
            "fill_money",
            "toggle",
            "configure_object"
          ]
        },
        "scope": { "$ref": "#/$defs/locator" },
        "target": { "$ref": "#/$defs/locator" },
        "expected_target_count": { "const": 1 },
        "readback": { "$ref": "#/$defs/locator" },
        "observed_options": { "type": "array", "items": { "type": "string" } },
        "input_constraints": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      }
    },
    "noActionComputerUse": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "blocked_state", "reason"],
      "properties": {
        "operation": { "const": "no_action" },
        "blocked_state": { "const": "platform_pending" },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "coverageCase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "field_keys",
        "status",
        "evidence_state",
        "exit_verified"
      ],
      "properties": {
        "id": { "type": "string" },
        "path": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "field_keys": { "type": "array", "items": { "type": "string" } },
        "status": {
          "enum": [
            "covered",
            "blocked_by_event_asset",
            "blocked_by_missing_parent_project",
            "blocked_by_account_capability",
            "blocked_by_platform_capability",
            "blocked_by_object_state",
            "blocked_by_missing_material",
            "blocked_by_input_constraint",
            "page_drift",
            "not_in_scope"
          ]
        },
        "evidence_state": {
          "enum": [
            "observed",
            "sample_only",
            "blocked_by_event_asset",
            "blocked_by_platform_capability",
            "blocked_by_missing_material",
            "blocked_by_input_constraint",
            "platform_pending",
            "page_drift"
          ]
        },
        "exit_verified": { "type": "boolean" },
        "reason": { "type": "string" }
      }
    },
    "consumer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_key", "destination", "treatment", "contract_path"],
      "properties": {
        "field_key": { "type": "string" },
        "destination": {
          "enum": [
            "DeliveryIntent",
            "OceanEngineConfiguration",
            "DeliveryDecisionCandidate",
            "CompiledDeliveryWorkflow",
            "PlatformSkill"
          ]
        },
        "treatment": {
          "enum": ["modelled", "dynamic_reference", "evidence_only", "blocked"]
        },
        "contract_path": { "type": "string", "minLength": 1 }
      }
    }
  }
}
