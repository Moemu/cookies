{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cookies.local/schemas/delivery-mechanistic-simulation-v0.json",
  "title": "Delivery Mechanistic Simulation v0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "model_version", "prior_set_version", "prior_set", "manifest_binding",
    "input_snapshot_hash", "stable_seed", "prediction_horizon", "sample_count",
    "metric_windows", "scenario_probabilities", "alerts", "recommendation_drafts",
    "assumptions", "limitations", "evidence_refs", "status", "is_simulated",
    "calibration_status"
  ],
  "properties": {
    "id": { "type": "string" },
    "organization_id": { "type": "string" },
    "project_id": { "type": "string" },
    "plan_id": { "type": "string" },
    "plan_version": { "type": "integer", "minimum": 1 },
    "schema_version": { "const": "delivery-mechanistic-simulation/v0" },
    "model_version": { "const": "delivery-mechanistic-monte-carlo/v0.2" },
    "prior_set_version": { "type": "string", "minLength": 1 },
    "prior_set": { "type": "object" },
    "manifest_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "manifest_id"],
      "properties": {
        "schema_version": { "const": "oceanengine-calibration-manifest/v1" },
        "manifest_id": { "type": "string", "minLength": 1 }
      }
    },
    "input_snapshot_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stable_seed": { "type": "string", "minLength": 1, "maxLength": 128 },
    "prediction_horizon": { "type": "string", "pattern": "^P([1-9]|[12][0-9]|3[01])D$" },
    "sample_count": { "type": "integer", "minimum": 100, "maximum": 100000 },
    "metric_windows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["sequence", "start", "end", "timezone", "metrics"],
        "properties": {
          "sequence": { "type": "integer", "minimum": 1 },
          "start": { "type": "string", "format": "date-time" },
          "end": { "type": "string", "format": "date-time" },
          "timezone": { "type": "string" },
          "metrics": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["available", "unit"],
              "properties": {
                "available": { "type": "boolean" },
                "unit": { "type": "string" },
                "p10": { "type": "number" },
                "p50": { "type": "number" },
                "p90": { "type": "number" },
                "mean": { "type": "number" }
              }
            }
          }
        }
      }
    },
    "scenario_probabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["scenario", "threshold_version", "probability", "status", "evidence_refs", "limitations"],
        "properties": {
          "scenario": { "enum": ["steady", "under_delivery", "cost_pressure", "creative_fatigue", "tracking_anomaly", "review_rejected", "zero_conversion", "spend_spike"] },
          "threshold_version": { "type": "string" },
          "probability": { "type": "number", "minimum": 0, "maximum": 1 },
          "status": { "enum": ["simulated", "suspected", "known_state"] },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "limitations": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "alerts": { "type": "array" },
    "recommendation_drafts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["recommendation_type", "target_field", "current_value", "suggested_range", "expected_effect_range", "confidence", "effect_basis", "rationale", "evidence_refs", "risks", "guardrails", "requires_human_review"],
        "properties": {
          "recommendation_type": { "type": "string" },
          "target_field": { "type": "string" },
          "current_value": {},
          "suggested_range": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
          "expected_effect_range": { "type": "array", "prefixItems": [{ "type": "number" }, { "type": "number" }], "minItems": 2, "maxItems": 2 },
          "confidence": { "type": "string" },
          "effect_basis": { "enum": ["predictive_association", "rule_constraint"] },
          "rationale": { "type": "string" },
          "evidence_refs": { "type": "array", "items": { "type": "string" } },
          "risks": { "type": "array", "items": { "type": "string" } },
          "guardrails": { "type": "array", "items": { "type": "string" } },
          "requires_human_review": { "const": true }
        }
      }
    },
    "assumptions": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "evidence_refs": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["completed", "platform_pending", "blocked"] },
    "is_simulated": { "const": true },
    "calibration_status": { "const": "assumption_driven" }
  }
}
